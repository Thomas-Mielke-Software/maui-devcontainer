{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Launch Controls.Sample",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build.Controls.Sample",
            "program": "${workspaceRoot}/maui/src/Controls/samples/Controls.Sample/bin/Debug/net8.0-gtk/linux-x64/Maui.Controls.Sample.dll",
            "args": [ "--framework net8.0-gtk" ],
            "cwd": "${workspaceRoot}/maui/src/Controls/samples/Controls.Sample",
            "stopAtEntry": false,
            "internalConsoleOptions": "openOnSessionStart"
        },
        {   // install VSCode Cake extension for source-level debugging of the cake script
            "name": "Cake Build Script (InstallWorkload)",
            "type": "coreclr",
            "request": "launch",
            "program": "${env:HOME}/.nuget/packages/cake.tool/4.0.0/tools/net8.0/any/Cake.dll",
            "args": [
                "${workspaceRoot}/maui/build.cake",
                "--target=dotnet-build",
                "--workloads=GtkSharp",
                "--gtk",
                "--debug",
                "--verbosity=diagnostic"
            ],
            "cwd": "${workspaceRoot}/maui",
            "stopAtEntry": false,
            "externalConsole": false
        }
    ]
}
